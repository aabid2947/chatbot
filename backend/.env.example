# Local MySQL from ../db.sh. Copy to .env and change if yours differs.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=chatbot
DB_USER=chatbot
DB_PASSWORD=chatbot
PORT=5000

# Local Claude Code is the model. Every call is a fresh `claude -p` process.
# Path to claude; leave unset to find it on PATH.
# CLAUDE_BIN=
# Model for replies, and for background jobs (titles; later facts and summaries).
CLAUDE_MODEL=sonnet
CLAUDE_BACKGROUND_MODEL=haiku
# Seconds before a stuck call is killed.
CLAUDE_TIMEOUT=300
# Messages always kept word for word; older ones fold into the chat summary
# once SUMMARY_BATCH more have piled up. RECENT_MESSAGES_MAX caps what's sent
# word for word even if summarising falls behind.
RECENT_MESSAGES=12
SUMMARY_BATCH=8
RECENT_MESSAGES_MAX=40
# 0 keeps the first message as the chat title.
GENERATE_TITLES=1
# Biggest PDF upload, in MB. Uploaded files go to ../storage/uploads unless UPLOADS_DIR is set.
UPLOAD_MAX_MB=50
# How many Claude calls summarize a long PDF's sections at once.
PDF_SUMMARY_WORKERS=3
# 0 turns off facts, scores and summaries (memory), or Claude's tools.
MEMORY_JOBS=1
TOOLS=1
